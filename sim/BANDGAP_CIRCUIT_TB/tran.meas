*Measurement extraction

.control

#ifdef Nosweep
load {cicname}.raw

meas tran Iptat avg I(VPTAT) from=2u to=14u
meas tran Vctat avg V(V_CTAT) from=2u to=14u
meas tran Ileak avg I(VDD) from=20u to=24u

echo "MEAS_START"
echo "iptat=$&Iptat"
echo "vctat=$&Vctat"
echo "ileak=$&Ileak"
echo "MEAS_END"
#else
set fend = .raw
foreach vtemp -40 -30 -20 -10 0 10 25 30 40 50 60 70 85 90 100 125

  load {cicname}_$vtemp$fend

  meas tran Iptat avg I(VPTAT) from=2u to=14u
  meas tran Vctat avg V(V_CTAT) from=2u to=14u
  meas tran Ileak avg I(VDD) from=20u to=24u

  echo "MEAS_START"
  echo "iptat_$vtemp=$&Iptat"
  echo "vctat_$vtemp=$&Vctat"
  echo "ileak_$vtemp=$&Ileak"
  echo "MEAS_END"

  destroy all

end
#endif

quit
.endc

.end
